// Правила доступу до бази Firestore.
// Цей файл — копія для історії: чинними є правила, вставлені в консолі Firebase
// (Firestore Database → Rules). Після зміни тут їх треба вставити туди ще раз.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // вхід через Google чи GitHub уже підтверджує особу; пошту перевіряємо лише для пароля
    function verified() {
      return signedIn() && (request.auth.token.email_verified == true
        || request.auth.token.firebase.sign_in_provider != 'password');
    }
    // заблокований адміністратором: читати може, писати коментарі й ставити лайки — ні
    function isBlocked() { return exists(/databases/$(database)/documents/blocked/$(request.auth.uid)); }
    function isAdmin()  { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    // Картка користувача: пише лише власник, читає власник і адміністратор
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['username', 'email', 'provider', 'joinedAt', 'lastLoginAt'])
        && request.resource.data.username is string && request.resource.data.username.size() <= 40
        && request.resource.data.email == request.auth.token.get('email', '');
      allow delete: if isAdmin();
    }

    // Адміністратори додаються лише вручну в консолі Firebase
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Блокування: ставить і знімає адміністратор; сам користувач бачить лише власне
    match /blocked/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // Коментарі читають усі; пише той, хто підтвердив пошту; видаляє автор або адміністратор
    match /comments/{id} {
      allow read: if true;
      allow create: if verified() && !isBlocked()
        && request.resource.data.keys().hasOnly(['postId', 'uid', 'username', 'text', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.postId is string && request.resource.data.postId.size() <= 40
        && request.resource.data.username is string && request.resource.data.username.size() <= 40
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
        && request.resource.data.createdAt == request.time;
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // Лайк — документ із назвою «пост_користувач», тому на один пост від людини він один
    match /likes/{id} {
      allow read: if true;
      allow create, update: if signedIn() && !isBlocked()
        && request.resource.data.keys().hasOnly(['postId', 'uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.postId is string && request.resource.data.postId.size() <= 40
        && (!('createdAt' in request.resource.data) || request.resource.data.createdAt == request.time)
        && id == request.resource.data.postId + '_' + request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Лічильники відвідувань, один документ на день. Писати може будь-хто, але тільки
    // додаючи по одиниці до дозволених полів; читає лише адміністратор
    match /stats/{day} {
      function fields() { return ['views', 'visitors', 'feed', 'about', 'donate', 'gallery', 'videos']; }
      function startsAtOne(k) { return !(k in request.resource.data) || request.resource.data[k] == 1; }
      function plusOne(k) {
        return !(k in request.resource.data) || request.resource.data[k] == resource.data.get(k, 0)
          || request.resource.data[k] == resource.data.get(k, 0) + 1;
      }
      allow read: if isAdmin();
      allow create: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(fields())
        && startsAtOne('views') && startsAtOne('visitors') && startsAtOne('feed') && startsAtOne('about')
        && startsAtOne('donate') && startsAtOne('gallery') && startsAtOne('videos');
      allow update: if request.resource.data.keys().hasOnly(fields())
        && plusOne('views') && plusOne('visitors') && plusOne('feed') && plusOne('about')
        && plusOne('donate') && plusOne('gallery') && plusOne('videos');
    }
  }
}
